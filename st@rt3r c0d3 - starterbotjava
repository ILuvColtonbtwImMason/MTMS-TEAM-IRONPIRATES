package org.firstinspires.ftc.teamcode;

import static com.qualcomm.robotcore.hardware.DcMotor.ZeroPowerBehavior.BRAKE;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.PIDFCoefficients;
import com.qualcomm.robotcore.util.ElapsedTime;
import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;
import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;

@Autonomous(name = "StarterBotAuto", group = "StarterBot")
public class StarterBotAuto extends OpMode {
    private static final double DRIVE_SPEED = 0.5;
    private static final double WHEEL_DIAMETER_MM = 96;
    private static final double ENCODER_TICKS_PER_REV = 537.7;
    private static final double TICKS_PER_MM = ENCODER_TICKS_PER_REV / (WHEEL_DIAMETER_MM * Math.PI);
    private static final double TRACK_WIDTH_MM = 402;
    private static final double TOLERANCE_MM = 10;
    private static final double INTAKE_POWER = 0.5;
    private static final int LAUNCHER_TARGET_VELOCITY = 1250;
    private static final int LAUNCHER_MIN_VELOCITY = 1200;

    private final ElapsedTime driveTimer = new ElapsedTime();
    private final ElapsedTime autoTimer = new ElapsedTime();
    private DcMotor leftDrive;
    private DcMotor rightDrive;
    private DcMotor intake;
    private DcMotorEx launcher;
    private CRServo leftIntakeServo;
    private CRServo rightIntakeServo;
    private CRServo windmillServo;
    private AutonomousState autonomousState;

    private enum AutonomousState { LAUNCH, DRIVE, COMPLETE }

    @Override
    public void init() {
        autonomousState = AutonomousState.LAUNCH;
        leftDrive = hardwareMap.get(DcMotor.class, "left_drive");
        rightDrive = hardwareMap.get(DcMotor.class, "right_drive");
        intake = hardwareMap.get(DcMotor.class, "intake");
        launcher = hardwareMap.get(DcMotorEx.class, "launcher");
        windmillServo = hardwareMap.get(CRServo.class, "windmill");
        leftIntakeServo = hardwareMap.get(CRServo.class, "left_intake_servo");
        rightIntakeServo = hardwareMap.get(CRServo.class, "right_intake_servo");

        leftDrive.setDirection(DcMotor.Direction.FORWARD);
        rightDrive.setDirection(DcMotor.Direction.REVERSE);
        leftDrive.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        rightDrive.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        leftDrive.setZeroPowerBehavior(BRAKE);
        rightDrive.setZeroPowerBehavior(BRAKE);
        intake.setZeroPowerBehavior(BRAKE);

        launcher.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        launcher.setPIDFCoefficients(DcMotor.RunMode.RUN_USING_ENCODER,
                new PIDFCoefficients(40, 0, 0, 12.5));

        leftIntakeServo.setPower(0);
        rightIntakeServo.setPower(0);
        windmillServo.setPower(0);
        rightIntakeServo.setDirection(DcMotorSimple.Direction.REVERSE);
        windmillServo.setDirection(DcMotorSimple.Direction.REVERSE);
        telemetry.addData("Status", "Initialized");
    }

    @Override
    public void start() {
        autoTimer.reset();
        driveTimer.reset();
    }

    @Override
    public void loop() {
        switch (autonomousState) {
            case LAUNCH:
                launch(true);
                if (autoTimer.seconds() > 10) {
                    launch(false);
                    // Begin the drive hold timer only after launch is finished.
                    driveTimer.reset();
                    autonomousState = AutonomousState.DRIVE;
                }
                break;
            case DRIVE:
                if (drive(DRIVE_SPEED, -120, DistanceUnit.MM, 2)) {
                    leftDrive.setPower(0);
                    rightDrive.setPower(0);
                    autonomousState = AutonomousState.COMPLETE;
                }
                break;
            case COMPLETE:
                leftDrive.setPower(0);
                rightDrive.setPower(0);
                launch(false);
                telemetry.addLine("Auto Complete!");
                break;
        }

        intake.setPower(intakePower);
        telemetry.addData("AutoState", autonomousState);
        telemetry.addData("Motor Current Positions", "left (%d), right (%d)",
                leftDrive.getCurrentPosition(), rightDrive.getCurrentPosition());
        telemetry.addData("Motor Target Positions", "left (%d), right (%d)",
                leftDrive.getTargetPosition(), rightDrive.getTargetPosition());
        telemetry.addData("Intake Power", intakePower);
        telemetry.update();
    }

    private double intakePower = 0;

    private void launch(boolean enabled) {
        if (!enabled) {
            launcher.setVelocity(0);
            windmillServo.setPower(0);
            intakePower = 0;
            return;
        }

        launcher.setVelocity(LAUNCHER_TARGET_VELOCITY);
        if (launcher.getVelocity() > LAUNCHER_MIN_VELOCITY) {
            windmillServo.setPower(1);
            // Assign a fixed power; do not accumulate power on every OpMode loop.
            intakePower = INTAKE_POWER;
        } else {
            windmillServo.setPower(0);
            intakePower = 0;
        }
    }

    /** Drive a distance and report completion after both motors remain in tolerance. */
    private boolean drive(double speed, double distance, DistanceUnit distanceUnit, double holdSeconds) {
        double targetTicks = distanceUnit.toMm(distance) * TICKS_PER_MM;
        leftDrive.setTargetPosition((int) targetTicks);
        rightDrive.setTargetPosition((int) targetTicks);
        leftDrive.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightDrive.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftDrive.setPower(Math.abs(speed));
        rightDrive.setPower(Math.abs(speed));

        double leftError = Math.abs(targetTicks - leftDrive.getCurrentPosition());
        double rightError = Math.abs(targetTicks - rightDrive.getCurrentPosition());
        boolean inTolerance = Math.max(leftError, rightError) <= TOLERANCE_MM * TICKS_PER_MM;
        if (!inTolerance) {
            driveTimer.reset();
            return false;
        }
        return driveTimer.seconds() >= holdSeconds;
    }

    /** Rotate by an angle and report completion after both motors remain in tolerance. */
    private boolean rotate(double speed, double angle, AngleUnit angleUnit, double holdSeconds) {
        double targetMm = angleUnit.toRadians(angle) * (TRACK_WIDTH_MM / 2);
        double leftTargetTicks = -targetMm * TICKS_PER_MM;
        double rightTargetTicks = targetMm * TICKS_PER_MM;
        leftDrive.setTargetPosition((int) leftTargetTicks);
        rightDrive.setTargetPosition((int) rightTargetTicks);
        leftDrive.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightDrive.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftDrive.setPower(Math.abs(speed));
        rightDrive.setPower(Math.abs(speed));

        double leftError = Math.abs(leftTargetTicks - leftDrive.getCurrentPosition());
        double rightError = Math.abs(rightTargetTicks - rightDrive.getCurrentPosition());
        boolean inTolerance = Math.max(leftError, rightError) <= TOLERANCE_MM * TICKS_PER_MM;
        if (!inTolerance) {
            driveTimer.reset();
            return false;
        }
        return driveTimer.seconds() >= holdSeconds;
    }

    @Override
    public void stop() {
        launch(false);
        intake.setPower(0);
        leftDrive.setPower(0);
        rightDrive.setPower(0);
        leftIntakeServo.setPower(0);
        rightIntakeServo.setPower(0);
    }
}
