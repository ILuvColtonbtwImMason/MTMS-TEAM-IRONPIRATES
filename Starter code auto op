package org.firstinspires.ftc.teamcode;

import static com.qualcomm.robotcore.hardware.DcMotor.ZeroPowerBehavior.BRAKE;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.PIDFCoefficients;
import com.qualcomm.robotcore.util.ElapsedTime;

import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;
import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;

import java.util.ArrayList;
import java.util.List;

/*
 * BioBuzz autonomous for Orion (goBILDA StarterBot base, four drive motors).
 * No sensors or camera: driving and turning use drive-motor encoders only.
 *
 * Hardware names (must match the Orion robot configuration exactly):
 *   left_front_drive, right_front_drive, left_back_drive, right_back_drive,
 *   intake, launcher, windmillServo, left_intake_servo, right_intake_servo
 *
 * Routine selection (during INIT, gamepad 1):
 *   dpad_right / dpad_left -> cycle through routines
 *
 * Routines:
 *   RED_HIVE_UP    : forward 3 in, turn right 90
 *   RED_HIVE_DOWN  : forward 6 in, backward 6 in (park)
 *   BLUE_HIVE_UP   : forward 6 in, turn 180, shoot, forward 6 in (park)
 *   BLUE_HIVE_DOWN : forward 6 in, backward 6 in (park)
 */
@Autonomous(name = "BioBuzz Auto", group = "BioBuzz")
public class BioBuzzAuto extends OpMode {

    // ---------- Launcher ----------
    public final int LAUNCHER_TARGET_VELOCITY = 1250;
    public final int LAUNCHER_MIN_VELOCITY = 1200;
    final double SHOOT_SECONDS = 10.0;    // Same as the StarterBot auto (all four projectiles). Tune on the field.

    // ---------- Drivetrain ----------
    final double DRIVE_SPEED = 0.5;
    final double ROTATE_SPEED = 0.2;
    final double WHEEL_DIAMETER_MM = 96;
    final double ENCODER_TICKS_PER_REV = 537.7;
    final double TICKS_PER_MM = (ENCODER_TICKS_PER_REV / (WHEEL_DIAMETER_MM * Math.PI));
    final double TRACK_WIDTH_MM = 402;    // Measure Orion. Affects 90 and 180 degree turns.
    final double HOLD_SECONDS = 0.5;      // Time the robot must sit at target before moving on.

    // ---------- Safety ----------
    final double AUTO_TIME_LIMIT = 30.0;  // Hard stop for the whole routine.

    // ---------- Routine selection ----------
    private enum Routine { RED_HIVE_UP, RED_HIVE_DOWN, BLUE_HIVE_UP, BLUE_HIVE_DOWN }
    private int selectedIndex = 0;
    private boolean lastDpadLeft = false;
    private boolean lastDpadRight = false;

    // ---------- Steps ----------
    private enum Step {
        FORWARD_3_IN,
        FORWARD_6_IN,
        BACKWARD_6_IN,
        TURN_RIGHT_90,
        TURN_180,
        SHOOT,
        DONE
    }
    private final List<Step> steps = new ArrayList<>();
    private int stepIndex = 0;

    // ---------- Timers ----------
    private ElapsedTime driveTimer = new ElapsedTime();   // Used by drive() and rotate()
    private ElapsedTime stepTimer = new ElapsedTime();    // Used by SHOOT
    private ElapsedTime autoTimer = new ElapsedTime();    // Whole routine

    // ---------- Hardware ----------
    private DcMotor leftFrontDrive = null;
    private DcMotor rightFrontDrive = null;
    private DcMotor leftBackDrive = null;
    private DcMotor rightBackDrive = null;
    private DcMotor[] driveMotors = null;
    private DcMotorEx launcher = null;
    private DcMotor intake = null;
    private CRServo leftIntakeServo = null;
    private CRServo rightIntakeServo = null;
    private CRServo windmillServo = null;

    private double intakePower = 0;

    @Override
    public void init() {
        leftFrontDrive = hardwareMap.get(DcMotor.class, "left_front_drive");
        rightFrontDrive = hardwareMap.get(DcMotor.class, "right_front_drive");
        leftBackDrive = hardwareMap.get(DcMotor.class, "left_back_drive");
        rightBackDrive = hardwareMap.get(DcMotor.class, "right_back_drive");
        intake = hardwareMap.get(DcMotor.class, "intake");
        launcher = hardwareMap.get(DcMotorEx.class, "launcher");
        windmillServo = hardwareMap.get(CRServo.class, "windmillServo");
        leftIntakeServo = hardwareMap.get(CRServo.class, "left_intake_servo");
        rightIntakeServo = hardwareMap.get(CRServo.class, "right_intake_servo");

        driveMotors = new DcMotor[] { leftFrontDrive, rightFrontDrive, leftBackDrive, rightBackDrive };

        // Left side forward, right side reversed (same as the StarterBot). If Orion drives
        // backward or spins on the first test, flip these on the wrong side(s).
        leftFrontDrive.setDirection(DcMotor.Direction.FORWARD);
        leftBackDrive.setDirection(DcMotor.Direction.FORWARD);
        rightFrontDrive.setDirection(DcMotor.Direction.REVERSE);
        rightBackDrive.setDirection(DcMotor.Direction.REVERSE);

        setDriveMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);

        for (DcMotor m : driveMotors) {
            m.setZeroPowerBehavior(BRAKE);
        }
        intake.setZeroPowerBehavior(BRAKE);

        launcher.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        launcher.setPIDFCoefficients(DcMotor.RunMode.RUN_USING_ENCODER, new PIDFCoefficients(40, 0, 0, 12.5));

        leftIntakeServo.setPower(0);
        rightIntakeServo.setPower(0);
        windmillServo.setPower(0);

        rightIntakeServo.setDirection(DcMotorSimple.Direction.REVERSE);
        windmillServo.setDirection(DcMotorSimple.Direction.REVERSE);

        telemetry.addData("Status", "Initialized");
        telemetry.addData("Routine", Routine.values()[selectedIndex]);
        telemetry.addLine("Use dpad left/right to choose");
    }

    @Override
    public void init_loop() {
        // Edge-detect the dpad so one press moves one routine.
        if (gamepad1.dpad_right && !lastDpadRight) {
            selectedIndex = (selectedIndex + 1) % Routine.values().length;
        }
        if (gamepad1.dpad_left && !lastDpadLeft) {
            selectedIndex = (selectedIndex + Routine.values().length - 1) % Routine.values().length;
        }
        lastDpadRight = gamepad1.dpad_right;
        lastDpadLeft = gamepad1.dpad_left;

        telemetry.addData("Routine (selected)", Routine.values()[selectedIndex]);
        telemetry.addLine("Use dpad left/right to choose");
        telemetry.update();
    }

    @Override
    public void start() {
        steps.clear();
        steps.addAll(buildSteps(Routine.values()[selectedIndex]));
        stepIndex = 0;

        autoTimer.reset();
        driveTimer.reset();
        stepTimer.reset();

        setDriveMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    }

    @Override
    public void loop() {
        intakePower = 0;

        // Safety timeout: jump to DONE if the routine runs too long.
        if (autoTimer.seconds() > AUTO_TIME_LIMIT) {
            stepIndex = steps.size() - 1;
        }

        Step current = steps.get(stepIndex);

        switch (current) {
            case FORWARD_3_IN:
                if (drive(DRIVE_SPEED, 3, DistanceUnit.INCH, HOLD_SECONDS)) advance();
                break;

            case FORWARD_6_IN:
                if (drive(DRIVE_SPEED, 6, DistanceUnit.INCH, HOLD_SECONDS)) advance();
                break;

            case BACKWARD_6_IN:
                if (drive(DRIVE_SPEED, -6, DistanceUnit.INCH, HOLD_SECONDS)) advance();
                break;

            case TURN_RIGHT_90:
                // Positive angle turns left in this drivetrain setup, so right is negative.
                if (rotate(ROTATE_SPEED, -90, AngleUnit.DEGREES, HOLD_SECONDS)) advance();
                break;

            case TURN_180:
                if (rotate(ROTATE_SPEED, 180, AngleUnit.DEGREES, HOLD_SECONDS)) advance();
                break;

            case SHOOT:
                launch(true);
                if (stepTimer.seconds() > SHOOT_SECONDS) {
                    launch(false);
                    advance();
                }
                break;

            case DONE:
                launch(false);
                setDrivePower(0);
                break;
        }

        intake.setPower(intakePower);

        telemetry.addData("Routine", Routine.values()[selectedIndex]);
        telemetry.addData("Step", current);
        telemetry.addData("Time", "%.1f s", autoTimer.seconds());
        telemetry.addData("Left positions", "front (%d), back (%d)",
                leftFrontDrive.getCurrentPosition(), leftBackDrive.getCurrentPosition());
        telemetry.addData("Right positions", "front (%d), back (%d)",
                rightFrontDrive.getCurrentPosition(), rightBackDrive.getCurrentPosition());
        telemetry.update();
    }

    @Override
    public void stop() {
        launch(false);
        setDrivePower(0);
        intake.setPower(0);
    }

    // ---------- Routine definitions ----------
    private List<Step> buildSteps(Routine routine) {
        List<Step> list = new ArrayList<>();
        switch (routine) {
            case RED_HIVE_UP:
                list.add(Step.FORWARD_3_IN);
                list.add(Step.TURN_RIGHT_90);
                break;
            case RED_HIVE_DOWN:
            case BLUE_HIVE_DOWN:
                list.add(Step.FORWARD_6_IN);
                list.add(Step.BACKWARD_6_IN);
                break;
            case BLUE_HIVE_UP:
                list.add(Step.FORWARD_6_IN);
                list.add(Step.TURN_180);
                list.add(Step.SHOOT);
                list.add(Step.FORWARD_6_IN);
                break;
        }
        list.add(Step.DONE);
        return list;
    }

    /*
     * Moves to the next step. drive() and rotate() use ABSOLUTE encoder targets, so the
     * encoders are reset here so every step's distance is relative to where the robot is now.
     */
    private void advance() {
        stepIndex++;
        driveTimer.reset();
        stepTimer.reset();
        setDriveMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
    }

    // ---------- Drive helpers (all four motors) ----------
    private void setDriveMode(DcMotor.RunMode mode) {
        for (DcMotor m : driveMotors) {
            m.setMode(mode);
        }
    }

    private void setDrivePower(double power) {
        for (DcMotor m : driveMotors) {
            m.setPower(power);
        }
    }

    /*
     * Sends the left pair and right pair to their targets and returns the WORST error (in ticks)
     * across all four motors, so a step only finishes when every wheel has arrived.
     */
    private double runToPositions(double leftTicks, double rightTicks, double speed) {
        leftFrontDrive.setTargetPosition((int) leftTicks);
        leftBackDrive.setTargetPosition((int) leftTicks);
        rightFrontDrive.setTargetPosition((int) rightTicks);
        rightBackDrive.setTargetPosition((int) rightTicks);

        setDriveMode(DcMotor.RunMode.RUN_TO_POSITION);
        setDrivePower(Math.abs(speed));

        double worst = 0;
        worst = Math.max(worst, Math.abs(leftTicks - leftFrontDrive.getCurrentPosition()));
        worst = Math.max(worst, Math.abs(leftTicks - leftBackDrive.getCurrentPosition()));
        worst = Math.max(worst, Math.abs(rightTicks - rightFrontDrive.getCurrentPosition()));
        worst = Math.max(worst, Math.abs(rightTicks - rightBackDrive.getCurrentPosition()));
        return worst;
    }

    // ---------- Launcher (from StarterBot) ----------
    void launch(boolean input) {
        if (input) {
            launcher.setVelocity(LAUNCHER_TARGET_VELOCITY);
        } else {
            launcher.setVelocity(0);
        }

        if (input && launcher.getVelocity() > LAUNCHER_MIN_VELOCITY) {
            windmillServo.setPower(1);
            intakePower += 0.5;
        } else {
            windmillServo.setPower(0);
        }
    }

    // ---------- Drive ----------
    boolean drive(double speed, double distance, DistanceUnit distanceUnit, double holdSeconds) {
        final double TOLERANCE_MM = 10;

        double targetTicks = distanceUnit.toMm(distance) * TICKS_PER_MM;
        double worstError = runToPositions(targetTicks, targetTicks, speed);

        if (worstError > (TOLERANCE_MM * TICKS_PER_MM)) {
            driveTimer.reset();
        }

        return driveTimer.seconds() > holdSeconds;
    }

    // ---------- Rotate ----------
    boolean rotate(double speed, double angle, AngleUnit angleUnit, double holdSeconds) {
        final double TOLERANCE_MM = 10;

        double targetMm = angleUnit.toRadians(angle) * (TRACK_WIDTH_MM / 2);

        double leftTargetTicks = -(targetMm * TICKS_PER_MM);
        double rightTargetTicks = targetMm * TICKS_PER_MM;
        double worstError = runToPositions(leftTargetTicks, rightTargetTicks, speed);

        if (worstError > (TOLERANCE_MM * TICKS_PER_MM)) {
            driveTimer.reset();
        }

        return driveTimer.seconds() > holdSeconds;
    }
}
